<?xml version="1.0" encoding="UTF-8"?>
<!--
=============================================================================
ANNOTATED COPY - Open3DPP field-census research note. Source file is verbatim
from Ultimaker/fdm_materials @ 886e7ad (2026-06-03), CC0-1.0. Only XML
comments have been added. Parser behaviour cited below is from
Cura/plugins/XmlMaterialProfile/XmlMaterialProfile.py @ 63f92d4.
EXAMPLE 3 of 3 - the floor of the format. A third-party profile with no
machine scoping at all: printer-agnostic, one setting, 646 bytes.
96 of 281 files (34%) have no <machine> block whatsoever.
=============================================================================
-->
<!-- No xmlns:cura declaration - the Cura extension namespace is optional and
     unused here.
-->
<fdmmaterial xmlns="http://www.ultimaker.com/material" version="1.3">
    <metadata>
        <name>
            <!-- <label> present, <material> generic: this is how a vendor expresses
                 'PolyFlex, which is a PLA'. An ingester should prefer
                 <label> over <material> for the SKU-precise product name.
            -->
            <brand>Polymaker</brand>
            <label>PolyFlex</label>
            <material>PLA</material>
            <color>Generic</color>
        </name>
        <!-- Its own GUID even though it is a thin variation on generic PLA. GUIDs are
             per-profile, so there is no vendor-family grouping in the identity model;
             <reference_material_id> (19 files) is the only lineage hint and nothing
             in Cura reads it.
        -->
        <GUID>88924e7b-a124-418f-a9b5-9fa56dbc47a3</GUID>
        <version>1</version>
        <color_code>#ffc924</color_code>
    </metadata>
    <!-- No <weight>: 114 of 281 files omit it.
    -->
    <properties>
        <density>1.24</density>
        <diameter>1.75</diameter>
    </properties>
    <!-- A single root-scope setting. Nothing here is printer- or core-specific, so
         Cura instantiates exactly one container and it applies everywhere. This is
         the majority shape for non-Ultimaker vendors, and it is why the format's
         pairing machinery is effectively an Ultimaker-hardware feature: 1,250 of
         1,454 machine_identifier elements name an Ultimaker printer.
    -->
    <settings>
        <setting key="print temperature">230</setting>
    </settings>
</fdmmaterial>

<?xml version="1.0" encoding="UTF-8"?>
<!--
=============================================================================
ANNOTATED COPY - Open3DPP field-census research note. Source file is verbatim
from Ultimaker/fdm_materials @ 886e7ad (2026-06-03), CC0-1.0. Only XML
comments have been added. Parser behaviour cited below is from
Cura/plugins/XmlMaterialProfile/XmlMaterialProfile.py @ 63f92d4.
EXAMPLE 1 of 3 - the canonical shape: every block type present,
9 <machine> blocks, 31 <hotend> blocks, and the only kind of file that
carries a <processing temperature graph>.
=============================================================================
-->
<!--
Generic PLA profile. The data in this file may not be correct for your specific machine.
-->
<fdmmaterial xmlns="http://www.ultimaker.com/material" xmlns:cura="http://www.ultimaker.com/cura" version="1.3">
    <!-- <metadata> holds identity + human-facing strings. Only GUID, brand,
         material and version are REQUIRED (XmlMaterialValidator.py); everything
         else is optional and several entries have no reader in Cura at all.
    -->
    <metadata>
        <!-- <name> is a 4-part composite key. Cura's display name = <label> if present,
             else '<color> <material>' (or just <material> when color == 'Generic').
        -->
        <name>
            <brand>Generic</brand>
            <material>PLA</material>
            <color>Generic</color>
        </name>
        <!-- GUID: vendor-generated UUIDv4, NOT centrally issued. It is the join key
             between a profile and a physical spool (NFC / Material Station / Digital
             Factory). Colour variants of the same product each get their OWN GUID.
        -->
        <GUID>506c9f0d-e3aa-4bd4-b2d2-23e2425b1aa9</GUID>
        <!-- <version> is a monotonic revision counter for THIS profile.
             It is unrelated to the format version in the root @version attribute.
        -->
        <version>47</version>
        <!-- Single hex string. There is no multi-colour representation in the format.
        -->
        <color_code>#ffc924</color_code>
        <description>Fast, safe and reliable printing. PLA is ideal for the fast and reliable printing of parts and prototypes with a great surface quality.</description>
        <!-- <adhesion_info>: free-text first-layer guidance. 91.8% coverage and no
             equivalent in OFD or Orca/Prusa -> harvest candidate.
        -->
        <adhesion_info>Print on bare glass. Use tape for cold build plates.</adhesion_info>
        <!-- cura: namespace = Cura-private extension. These two flags have NO reader
             anywhere in the Cura source tree at rev 63f92d4; the serialiser is the
             only code that names them.
        -->
        <cura:pva_compatible>True</cura:pva_compatible>
        <cura:breakaway_compatible>True</cura:breakaway_compatible>
    <!-- <properties> = intrinsic material facts. Only <diameter> is wired to a
         slicing setting (material_diameter). <density> and <weight> are read into
         metadata['properties'] and surfaced in the UI model, never used to slice.
         No unit is declared or validated anywhere: density is g/cm3 BY CONVENTION
         only, and one file in the corpus (eazao_clay) states 1600, i.e. kg/m3.
    -->
    </metadata>
    <properties>
        <!-- diameter also derives metadata['approximate_diameter'] = str(round(d)),
             which is the 1.75-vs-2.85 filter used to hide incompatible materials.
        -->
        <density>1.24</density>
        <diameter>2.85</diameter>
    <!-- <settings>: direct <setting> children are the ROOT scope - they apply to
         every machine and every hotend unless a narrower block overrides them.
         Resolution is a 3-level cascade, most specific wins:
           root  ->  machine  ->  hotend   (a 4th level, buildplate, exists in the
         parser but is used by 0 of 281 files).
         Cura materialises this as separate container objects with ids
           <base>, <base>_<machine_id>, <base>_<machine_id>_<hotend_name>
         each pre-merged, so lookup at slice time is a dict hit, not a walk.
    -->
    </properties>
    <settings>
        <!-- 'Deprime'/material-station keys. Most are in the parser's
             __keep_serialized_settings set: stored verbatim on load, written back out
             on save, and never consumed by Cura itself.
        -->
        <!-- Deprime settings -->
        <setting key="anti ooze retract position">-4</setting>
        <setting key="anti ooze retract speed">50</setting>
        <setting key="break preparation position">-16</setting>
        <setting key="break preparation speed">50</setting>
        <setting key="break preparation temperature">210</setting>
        <setting key="break position">-50</setting>
        <setting key="break speed">25</setting>
        <setting key="break temperature">60</setting>
        <setting key="pressure release dwell time">25</setting>
        <setting key="dwell time before break preparation move">4</setting>
        <setting key="end of print purge volume">0</setting>
        <setting key="end of filament purge volume">0</setting>
        <setting key="flush purge length">60</setting>

        <!-- material station (un)loading settings -->
        <setting key="maximum park duration">7200</setting>
        <setting key="no load move factor">0.91</setting>
 <!-- NOTE: 'print temperature' -> default_material_print_temperature (degC).
      The parser does NO unit conversion at all - values are handed to the
      setting container as raw strings. Units live in fdmprinter.def.json,
      not in this file and not in the plugin.
 -->

        <!-- print settings -->
        <setting key="print temperature">200</setting>
        <setting key="standby temperature">100</setting>
        <setting key="heated bed temperature">60</setting>
        <!-- 'adhesion tendency' (int index) and 'surface energy' (%) are Ultimaker-only
             material descriptors. Neither exists in OFD or the Orca/Prusa family.
        -->
        <setting key="build volume temperature">28</setting>
        <setting key="print cooling">100</setting>
        <setting key="adhesion tendency">0</setting>
        <setting key="surface energy">100</setting>

        <!-- For material flow sensor -->
        <!-- 'retract compensation' is present in 103 of 281 files (36.7%) but appears
             in NO map in XmlMaterialProfile.py -> Cura logs 'Unsupported material
             setting' and DROPS it. Widely-written, entirely unread.
        -->
        <setting key="relative extrusion">1.0</setting>
        <setting key="retract compensation">0</setting>

        <!-- MACHINE SCOPE. A <machine> block may carry SEVERAL <machine_identifier>
             children; that is a shorthand for 'these printers share this block'.
             _expandMachinesXML() clones the block once per identifier before merging,
             so the shorthand is purely a file-size optimisation.
        -->
        <machine>
            <!-- @product is a human-readable printer NAME, not an id. Cura resolves it via
                 FormatMaps.getProductIdMap(); on a miss it falls back to
                 getPossibleDefinitionIDsFromName() string mangling (spaces stripped /
                 underscored, digits glued to the preceding word). @manufacturer is
                 optional and defaults to the printer definition's own manufacturer.
            -->
            <machine_identifier manufacturer="Ultimaker B.V." product="Ultimaker 2+" />
            <machine_identifier manufacturer="Ultimaker B.V." product="Ultimaker 2 Extended+" />

            <!-- Bare <hotend id=.../> with no children: it declares that the pairing
                 EXISTS (so Cura instantiates a container for it) while inheriting every
                 value from the machine scope. 256 of 2905 hotend blocks are empty.
            -->
            <hotend id="0.25 mm" />
            <hotend id="0.4 mm" />
            <hotend id="0.6 mm" />
            <hotend id="0.8 mm" />
        </machine>

        <!-- Only 13 of 281 files carry a <processing temperature graph>. It is the one
             genuinely constitutive relation in the format: extrusion flow (mm3/s) ->
             required nozzle temperature (degC), parsed to [[flow,temp],...] floats and
             stored as material_flow_temp_graph. OrcaSlicer has adopted the same key.
        -->
        <machine>
            <machine_identifier manufacturer="Ultimaker B.V." product="Ultimaker 2" />
            <machine_identifier manufacturer="Ultimaker B.V." product="Ultimaker 2 Go" />
            <machine_identifier manufacturer="Ultimaker B.V." product="Ultimaker 2 Extended" />
            <setting key="processing temperature graph">
                <point flow="2" temperature="180" />
                <point flow="10" temperature="230" />
            </setting>
        </machine>

        <machine>
            <machine_identifier manufacturer="Ultimaker B.V." product="Ultimaker Original" />
        </machine>

        <!-- Hotend-scoped override. 'AA 0.25' etc. are Ultimaker print-CORE names.
             The same nozzle diameter appears under several core codes (AA 0.4, BB 0.4,
             CC 0.4, DD 0.4 all exist in the corpus), so core identity is NOT reducible
             to nozzle diameter - which is exactly the axis a diameter-only schema
             loses.
        -->
        <machine>
            <machine_identifier manufacturer="Ultimaker B.V." product="Ultimaker 3" />
            <machine_identifier manufacturer="Ultimaker B.V." product="Ultimaker 3 Extended" />
            <setting key="print cooling">100</setting>
            <hotend id="AA 0.25">
                <setting key="hardware compatible">yes</setting>
                <setting key="retraction amount">6.5</setting>
            </hotend>
            <hotend id="AA 0.4">
                <setting key="hardware compatible">yes</setting>
            </hotend>
            <hotend id="AA 0.8">
                <setting key="hardware compatible">yes</setting>
                <setting key="retraction amount">5</setting>
                <cura:setting key="cool_min_layer_time">10</cura:setting>
            </hotend>
        </machine>

        <!-- Here the same PLA needs a different nozzle temperature per nozzle size on
             one printer (195/210/230/240 degC for 0.25/0.4/0.6/0.8 mm). This is the
             machine-material pairing the format exists to express.
        -->
        <machine>
            <machine_identifier manufacturer="Ultimaker B.V." product="Ultimaker 2+ Connect" />
            <setting key="hardware compatible">yes</setting>
            <hotend id="0.25 mm">
                <setting key="print temperature">195</setting>
            </hotend>
            <hotend id="0.4 mm">
                <setting key="print temperature">210</setting>
            </hotend>
            <hotend id="0.6 mm">
                <setting key="print temperature">230</setting>
            </hotend>
            <hotend id="0.8 mm">
                <setting key="print temperature">240</setting>
                <cura:setting key="cool_min_layer_time">10</cura:setting>
            </hotend>
        </machine>

        <machine>
            <machine_identifier manufacturer="Ultimaker B.V." product="Ultimaker S3" />
            <setting key="print cooling">100</setting>
            <cura:setting key="material_shrinkage_percentage">100.2</cura:setting>
            <cura:setting key="material_shrinkage_percentage_z">100.1</cura:setting>
            <hotend id="AA 0.25">
                <setting key="hardware compatible">yes</setting>
                <setting key="retraction amount">6.5</setting>
            </hotend>
            <hotend id="AA 0.4">
                <setting key="hardware compatible">yes</setting>
            </hotend>
            <hotend id="AA 0.8">
                <setting key="hardware compatible">yes</setting>
                <setting key="retraction amount">5</setting>
                <cura:setting key="cool_min_layer_time">10</cura:setting>
            </hotend>
            <hotend id="CC 0.4">
                <setting key="hardware compatible">yes</setting>
                <setting key="retraction amount">6.5</setting>
            </hotend>
            <hotend id="CC 0.6">
                <setting key="hardware compatible">yes</setting>
                <setting key="retraction amount">6.5</setting>
                <cura:setting key="cool_min_layer_time">10</cura:setting>
            </hotend>

        </machine>

        <machine>
            <machine_identifier manufacturer="Ultimaker B.V." product="Ultimaker S5" />
            <machine_identifier manufacturer="Ultimaker B.V." product="Ultimaker S6" />
            <machine_identifier manufacturer="Ultimaker B.V." product="Ultimaker S7" />
            <machine_identifier manufacturer="Ultimaker B.V." product="Ultimaker S8" />

            <setting key="print cooling">100</setting>
            <cura:setting key="material_shrinkage_percentage">100.2</cura:setting>
            <cura:setting key="material_shrinkage_percentage_z">100.1</cura:setting>
            <hotend id="AA 0.25">
                <setting key="hardware compatible">yes</setting>
                <setting key="retraction amount">6.5</setting>
            </hotend>
            <hotend id="AA 0.4">
                <setting key="hardware compatible">yes</setting>
            </hotend>
            <hotend id="AA 0.8">
                <setting key="hardware compatible">yes</setting>
                <setting key="retraction amount">5</setting>
                <cura:setting key="cool_min_layer_time">10</cura:setting>
            </hotend>
            <hotend id="CC 0.4">
                <setting key="hardware compatible">yes</setting>
                <setting key="retraction amount">6.5</setting>
                <cura:setting key="material_crystallinity">true</cura:setting>
            </hotend>
            <hotend id="CC 0.6">
                <setting key="hardware compatible">yes</setting>
                <setting key="retraction amount">6.5</setting>
                <cura:setting key="cool_min_layer_time">10</cura:setting>
                <cura:setting key="material_crystallinity">true</cura:setting>
            </hotend>
            <hotend id="AA+ 0.4">
                <setting key="hardware compatible">yes</setting>
                <setting key="print temperature">210</setting>
                <setting key="heated bed temperature">55</setting>
                <setting key="standby temperature">175</setting>
                <setting key="no load move factor">1.0</setting>
            </hotend>
        </machine>

        <machine>
            <machine_identifier manufacturer="Ultimaker B.V." product="Ultimaker Factor 4" />
            <setting key="heated bed temperature">55</setting>
            <setting key="build volume temperature">30</setting>
            <setting key="print cooling">100</setting>
            <setting key="anti ooze retract position">-2</setting>
            <setting key="break preparation position">-14</setting>
            <setting key="no load move factor">1</setting>
            <cura:setting key="material_shrinkage_percentage">100.16</cura:setting>
            <hotend id="AA 0.25">
                <setting key="hardware compatible">yes</setting>
            </hotend>
            <hotend id="AA 0.4">
                <setting key="hardware compatible">yes</setting>
                <setting key="print temperature">200</setting>
            </hotend>
            <hotend id="AA 0.8">
                <setting key="hardware compatible">yes</setting>
                <cura:setting key="cool_min_layer_time">10</cura:setting>
            </hotend>
            <hotend id="CC 0.4">
                <setting key="hardware compatible">yes</setting>
            </hotend>
            <hotend id="CC 0.6">
                <setting key="hardware compatible">yes</setting>
                <cura:setting key="cool_min_layer_time">10</cura:setting>
            </hotend>
        </machine>

        <machine>
            <machine_identifier manufacturer="Ultimaker B.V." product="Ultimaker Factor 4+" />
            <setting key="heated bed temperature">55</setting>
            <setting key="build volume temperature">30</setting>
            <setting key="print cooling">100</setting>
            <setting key="print temperature">210</setting>
            <setting key="anti ooze retract position">-2</setting>
            <setting key="break preparation position">-14</setting>
            <setting key="no load move factor">1</setting>
            <cura:setting key="material_shrinkage_percentage">100.16</cura:setting>

            <hotend id="AA 0.25">
                <setting key="hardware compatible">yes</setting>
            </hotend>
            <hotend id="AA 0.4">
                <setting key="hardware compatible">yes</setting>
                <setting key="print temperature">200</setting>
            </hotend>
            <hotend id="AA 0.8">
                <setting key="hardware compatible">yes</setting>
                <cura:setting key="cool_min_layer_time">10</cura:setting>
            </hotend>
            <hotend id="AA+ 0.4">
                <setting key="hardware compatible">yes</setting>
                <setting key="print temperature">215</setting>
            </hotend>
        </machine>

    </settings>
</fdmmaterial>
